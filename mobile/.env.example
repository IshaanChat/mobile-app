# Copy to .env. EXPO_PUBLIC_* vars are embedded in the app bundle at build
# time — never put secrets here.

# API origin — no trailing slash, no /api. Defaults to the deployed Render
# API if unset. For a local server on a real device, use your LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
EXPO_PUBLIC_API_URL=https://sales-mechanic-api.onrender.com

# Clerk publishable key (safe to expose — it is a public key). When set, the
# app requires real sign-in. Unset = dev mode: the API treats every request
# as the development account (local servers only).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
