DEFINE SCHEMA

    RECORD TYPE Niche (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        name                     STRING,
        domain                   STRING QUERYABLE,
        audience                 STRING QUERYABLE,
        imageUrl                 STRING,
        imageCredit              STRING,
        tags                     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Product (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        title                    STRING SEARCHABLE,
        blurb                    STRING,
        nicheSlug                STRING QUERYABLE,
        sourcingType             STRING QUERYABLE,
        sourceName               STRING,
        sourcingUrl              STRING,
        sourceCost               STRING,
        sourceCategory           STRING,
        typicalResale            STRING,
        imageUrl                 STRING,
        imageCredit              STRING,
        hotness                  INT64 QUERYABLE SORTABLE,
        tier                     STRING QUERYABLE,
        signalHeat               INT64,
        signalInterest           INT64,
        signalInterestTrend      DOUBLE,
        signalUnitsSold          INT64,
        signalPriceLow           DOUBLE,
        signalPriceHigh          DOUBLE,
        signalPolledAt           STRING,
        signalSources            LIST<STRING>,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Community (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        title                    STRING SEARCHABLE,
        tagline                  STRING,
        platform                 STRING QUERYABLE,
        kind                     STRING QUERYABLE,
        url                      STRING,
        overview                 STRING,
        audience                 STRING,
        loves                    STRING,
        dislikes                 STRING,
        approach                 STRING,
        rules                    STRING,
        discussions              STRING,
        hotness                  INT64 QUERYABLE SORTABLE,
        imageUrl                 STRING,
        imageCredit              STRING,
        tags                     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Tip (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        kind                     STRING QUERYABLE,
        text                     STRING,
        tab                      STRING QUERYABLE,
        level                    INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE JourneyLevel (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        level                    INT64 QUERYABLE SORTABLE,
        name                     STRING,
        title                    STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Milestone (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        title                    STRING,
        detail                   STRING,
        level                    INT64 QUERYABLE SORTABLE,
        tab                      STRING QUERYABLE,
        trigger                  STRING QUERYABLE,
        place                    STRING,
        xp                       INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Playbook (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        name                     STRING,
        blurb                    STRING,
        steps                    LIST<STRING>,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE OnboardingScript (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        json                     STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Profile (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        name                     STRING,
        email                    STRING,
        age                      INT64,
        gender                   STRING,
        location                 STRING,
        phone                    STRING,
        bio                      STRING,
        experienceLevel          STRING,
        goals                    STRING,
        createdAt                INT64 SORTABLE,
        updatedAt                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Business (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        name                     STRING,
        niche                    STRING,
        about                    STRING,
        idealCustomer            STRING,
        audienceKeywords         STRING,
        salesAvenues             STRING,
        businessType             STRING,
        pageUrl                  STRING,
        createdAt                INT64 SORTABLE,
        updatedAt                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SavedTrend (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        productSlug              STRING QUERYABLE,
        savedAt                  INT64 SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE MilestoneCompletion (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        milestoneSlug            STRING QUERYABLE,
        completedAt              INT64 SORTABLE,
        xpAwarded                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Channel (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        businessId               STRING QUERYABLE,
        type                     STRING,
        label                    STRING,
        url                      STRING,
        createdAt                INT64 SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Contact (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        businessId               STRING QUERYABLE,
        channelId                STRING QUERYABLE,
        name                     STRING,
        notes                    STRING,
        sourceUrl                STRING,
        status                   STRING QUERYABLE,
        relationshipStrength     DOUBLE,
        engagementScore          DOUBLE,
        createdAt                INT64 SORTABLE,
        updatedAt                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Interaction (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        contactId                STRING QUERYABLE,
        businessId               STRING QUERYABLE,
        type                     STRING,
        occurredAt               INT64 SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Payment (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        businessId               STRING QUERYABLE,
        contactId                STRING QUERYABLE,
        productId                STRING,
        amount                   DOUBLE,
        quantity                 INT64,
        note                     STRING,
        occurredAt               INT64 SORTABLE,
        createdAt                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE ShelfProduct (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        businessId               STRING QUERYABLE,
        name                     STRING,
        about                    STRING,
        price                    DOUBLE,
        stock                    INT64,
        sku                      STRING,
        url                      STRING,
        createdAt                INT64 SORTABLE,
        updatedAt                INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE SocialLink (
        "___createTime"          TIMESTAMP,
        "___createdBy"           REFERENCE,
        "___etag"                STRING,
        "___modTime"             TIMESTAMP,
        "___modifiedBy"          REFERENCE,
        "___recordID"            REFERENCE QUERYABLE,
        businessId               STRING QUERYABLE,
        platform                 STRING QUERYABLE,
        url                      STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );
