// Sales Mechanic — data model
// PostgreSQL via Prisma (Neon in dev and production).
//
// Note: "enum-like" fields (channel type, contact status, interaction type,
// business type…) are plain Strings validated in the API routes rather than
// native enums — a constraint inherited from the SQLite prototype that is
// worth keeping, since changing an allowed value no longer needs a migration.
// See server/src/routes/*.ts for the allowed values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use Neon's DIRECT (non-pooled) connection string. Prisma keeps its own
  // connection pool, and Prisma Migrate cannot run through Neon's pooler,
  // so a single direct URL is both sufficient and simpler at this scale.
  url = env("DATABASE_URL")
}

// An account. `externalId` is the id from the auth provider (Clerk); in
// local dev it is a stable stand-in so the app works without Clerk keys.
model User {
  id         String   @id @default(cuid())
  externalId String   @unique
  email      String?
  createdAt  DateTime @default(now())

  businesses Business[]
  profile    UserProfile?
  settings   AppSetting[]
  trendReactions SavedTrend[]
}

model Business {
  id          String   @id @default(cuid())
  name        String
  niche       String
  description String
  // Discover targeting: who they're looking for, in their own words.
  idealCustomer String?
  // Comma-separated interest/niche keywords used for recommendations.
  audienceKeywords String?
  // Comma-separated sales avenues: ETSY, SHOPIFY, DEPOP, AMAZON, EBAY,
  // INSTAGRAM_SHOP, OWN_WEBSITE, IN_PERSON, OTHER
  salesAvenues String?
  // One of: PRODUCT_SALES, SERVICE, KNOWLEDGE, OTHER. Tunes scoring and
  // Discover for how this kind of business actually sells.
  businessType String?
  // The business's public page — shop, website, linktree, booking page.
  pageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channels Channel[]
  contacts Contact[]
  socials  SocialLink[]
  payments Payment[]
  products Product[]

  @@index([userId])
}

model Channel {
  id String @id @default(cuid())
  // One of: ETSY, INSTAGRAM, REDDIT, REFERRAL, OTHER
  type String
  // Display label — required for OTHER (e.g. "Craft Fair"), optional override otherwise.
  label String?
  // First URL this channel was detected from (e.g. the Etsy shop link).
  url String?
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contacts Contact[]
}

model Contact {
  id     String  @id @default(cuid())
  name   String
  notes  String?
  // The profile/shop/post URL where this person was found, if any.
  sourceUrl String?
  // One of: PROSPECT, ENGAGED, CUSTOMER
  status String @default("PROSPECT")

  // Derived scores, recalculated whenever an interaction is logged.
  // Both range 0-100.
  relationshipStrength Float @default(0) // recency + frequency + value -> drives node size
  engagementScore      Float @default(0) // recency + frequency only -> drives edge thickness

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  interactions Interaction[]
  payments     Payment[]
}

// Per-user key-value settings (e.g. self-hosted LLM connection).
// Editable from the UI so users never have to touch .env.
model AppSetting {
  id    String @id @default(cuid())
  key   String
  value String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// The person running the businesses — one profile per account.
model UserProfile {
  id    String @id @default(cuid())
  // Required at onboarding
  name  String
  email String
  age   Int
  // One of: WOMAN, MAN, NON_BINARY, OTHER, PREFER_NOT_TO_SAY
  gender String
  // Optional — addable later from My Business
  location        String?
  phone           String?
  bio             String?
  // One of: FIRST_TIME, SOME_EXPERIENCE, EXPERIENCED
  experienceLevel String?
  goals           String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A business's presence on a social platform.
// One of: TWITTER, INSTAGRAM, TIKTOK, YOUTUBE, REDDIT, FACEBOOK, PINTEREST
model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
}

// One row per completed mission per period. businessId is "global" for
// missions that aren't tied to a specific business (e.g. profile missions).
// periodKey: "once" for one-time missions; "2026-07-20" daily; "2026-W30"
// weekly; "2026-07" monthly — repeatable missions reappear each period.
model MissionCompletion {
  id          String   @id @default(cuid())
  missionId   String
  businessId  String
  periodKey   String   @default("once")
  xpAwarded   Int
  completedAt DateTime @default(now())

  @@unique([missionId, businessId, periodKey])
}

// Product analytics: one row per meaningful app action. Local-first —
// this data never leaves the user's own database.
model AppEvent {
  id         String   @id @default(cuid())
  type       String
  businessId String?
  // JSON string with event-specific details.
  payload    String?
  createdAt  DateTime @default(now())

  @@index([businessId, type])
}

// A product or offering the business sells. stock = null means "not
// tracked" (services, digital goods, made-to-order).
model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float?
  stock       Int?
  sku         String?
  // Link to the live listing (Etsy page, Shopify product, booking page…)
  url String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  payments Payment[]
}

// A payment received — the finances page is intentionally light for now.
model Payment {
  id         String   @id @default(cuid())
  amount     Float
  note       String?
  quantity   Int      @default(1)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// Curated content for the Discover feed: a product source / trend worth a
// look. GLOBAL content, not user-owned — the only such table. Rows are
// loaded by the curator via `npm run trends:import` (see content/README.md);
// users can only read and react. Never accept card writes from the API.
model TrendCard {
  id   String @id @default(cuid())
  // Curator-chosen stable identity so re-importing updates in place.
  slug String @unique

  title String
  // Why this could take off, in the curator's words — the card's body text.
  blurb String
  // Shelf label ("Jewelry", "Home & decor"…). Drives feed diversity.
  category String
  // Comma-separated match keywords (same convention as Business fields).
  tags String

  imageUrl   String?
  // Where the trend was spotted, e.g. "TikTok" + a link worth opening.
  sourceName String?
  sourceUrl  String?
  // Free text, e.g. "$15–40"
  priceRange String?
  // Curator-set 0–100: how hot this is right now.
  hotness Int @default(50)
  // One of: ACTIVE, ARCHIVED. Archived cards leave the feed but existing
  // saves keep working, so nobody's idea shelf silently loses entries.
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions SavedTrend[]

  @@index([status])
}

// Curated content for the Growth feed: a community/place where a business
// finds customers, written up as a coached blog-style post. Same global,
// curator-owned model as TrendCard: loaded via `npm run growth:import`,
// read-only through the API. Live stats (memberCount, icon images) are
// nullable — a later enricher job fills them from sanctioned APIs (Reddit
// public JSON, YouTube API); nothing is ever scraped against ToS.
model CommunityPost {
  id   String @id @default(cuid())
  // Curator-chosen stable identity so re-importing updates in place.
  slug String @unique

  title String
  // Where it lives: Reddit, Instagram, TikTok, X, YouTube, Etsy, Pinterest,
  // Facebook, Forum… Drives feed diversity and card styling.
  platform String
  // One of: community, hashtag, marketplace, search, event
  kind String
  url  String

  // Card text (one line) and the blog-post depth behind the tap.
  tagline  String
  // Who a business will actually find there — buyers, peers, lurkers.
  audience String
  // The coached write-up: what it is, how to show up, what converts.
  // Plain text with blank-line paragraph breaks.
  body String

  // Comma-separated match keywords (same convention as Business fields).
  tags String

  imageUrl    String?
  // Filled by the enricher where an official API provides it.
  memberCount Int?
  // Curator-set 0–100 editorial priority.
  hotness Int @default(50)
  // One of: ACTIVE, ARCHIVED
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A user's reaction to a trend card. state: SAVED (their idea shelf) or
// DISMISSED (never show again). Doubles as the engagement log the ranking
// algorithm will learn from later.
model SavedTrend {
  id String @id @default(cuid())
  // One of: SAVED, DISMISSED
  state     String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  trendCardId String
  trendCard   TrendCard @relation(fields: [trendCardId], references: [id], onDelete: Cascade)

  @@unique([userId, trendCardId])
  @@index([userId, state])
}

model Interaction {
  id String @id @default(cuid())
  // One of: MESSAGE, MEETING, PURCHASE, REVIEW, OTHER
  type String
  note String?
  // Subjective impact/value of this interaction, 1 (light touch) - 5 (major, e.g. a sale).
  weight Int @default(1)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}
