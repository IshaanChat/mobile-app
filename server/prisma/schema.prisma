// Venturo — data model
// PostgreSQL via Prisma (Neon in dev and production).
//
// Note: "enum-like" fields (channel type, contact status, interaction type,
// business type…) are plain Strings validated in the API routes rather than
// native enums — a constraint inherited from the SQLite prototype that is
// worth keeping, since changing an allowed value no longer needs a migration.
// See server/src/routes/*.ts for the allowed values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Use Neon's DIRECT (non-pooled) connection string. Prisma keeps its own
  // connection pool, and Prisma Migrate cannot run through Neon's pooler,
  // so a single direct URL is both sufficient and simpler at this scale.
  url      = env("DATABASE_URL")
}

// An account. `externalId` is the id from the auth provider (Clerk); in
// local dev it is a stable stand-in so the app works without Clerk keys.
model User {
  id         String   @id @default(cuid())
  externalId String   @unique
  email      String?
  createdAt  DateTime @default(now())

  businesses     Business[]
  profile        UserProfile?
  settings       AppSetting[]
  trendReactions SavedTrend[]
}

model Business {
  id               String   @id @default(cuid())
  name             String
  niche            String
  description      String
  // Discover targeting: who they're looking for, in their own words.
  idealCustomer    String?
  // Comma-separated interest/niche keywords used for recommendations.
  audienceKeywords String?
  // Comma-separated sales avenues: ETSY, SHOPIFY, DEPOP, AMAZON, EBAY,
  // INSTAGRAM_SHOP, OWN_WEBSITE, IN_PERSON, OTHER
  salesAvenues     String?
  // One of: PRODUCT_SALES, SERVICE, KNOWLEDGE, OTHER. Tunes scoring and
  // Discover for how this kind of business actually sells.
  businessType     String?
  // The business's public page — shop, website, linktree, booking page.
  pageUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channels Channel[]
  contacts Contact[]
  socials  SocialLink[]
  payments Payment[]
  products Product[]

  @@index([userId])
}

model Channel {
  id        String   @id @default(cuid())
  // One of: ETSY, INSTAGRAM, REDDIT, REFERRAL, OTHER
  type      String
  // Display label — required for OTHER (e.g. "Craft Fair"), optional override otherwise.
  label     String?
  // First URL this channel was detected from (e.g. the Etsy shop link).
  url       String?
  createdAt DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contacts Contact[]
}

model Contact {
  id        String  @id @default(cuid())
  name      String
  notes     String?
  // The profile/shop/post URL where this person was found, if any.
  sourceUrl String?
  // One of: PROSPECT, ENGAGED, CUSTOMER
  status    String  @default("PROSPECT")

  // Derived scores, recalculated whenever an interaction is logged.
  // Both range 0-100.
  relationshipStrength Float @default(0) // recency + frequency + value -> drives node size
  engagementScore      Float @default(0) // recency + frequency only -> drives edge thickness

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  interactions Interaction[]
  payments     Payment[]
}

// Per-user key-value settings (e.g. self-hosted LLM connection).
// Editable from the UI so users never have to touch .env.
model AppSetting {
  id    String @id @default(cuid())
  key   String
  value String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// The person running the businesses — one profile per account.
model UserProfile {
  id              String   @id @default(cuid())
  // Required at onboarding
  name            String
  email           String
  age             Int
  // One of: WOMAN, MAN, NON_BINARY, OTHER, PREFER_NOT_TO_SAY
  gender          String
  // Optional — addable later from My Business
  location        String?
  phone           String?
  bio             String?
  // One of: FIRST_TIME, SOME_EXPERIENCE, EXPERIENCED
  experienceLevel String?
  goals           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A business's presence on a social platform.
// One of: TWITTER, INSTAGRAM, TIKTOK, YOUTUBE, REDDIT, FACEBOOK, PINTEREST
model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, platform])
}

// One row per completed mission per period. businessId is "global" for
// missions that aren't tied to a specific business (e.g. profile missions).
// periodKey: "once" for one-time missions; "2026-07-20" daily; "2026-W30"
// weekly; "2026-07" monthly — repeatable missions reappear each period.
model MissionCompletion {
  id          String   @id @default(cuid())
  missionId   String
  businessId  String
  periodKey   String   @default("once")
  xpAwarded   Int
  completedAt DateTime @default(now())

  @@unique([missionId, businessId, periodKey])
}

// Product analytics: one row per meaningful app action. Local-first —
// this data never leaves the user's own database.
model AppEvent {
  id         String   @id @default(cuid())
  type       String
  businessId String?
  // JSON string with event-specific details.
  payload    String?
  createdAt  DateTime @default(now())

  @@index([businessId, type])
}

// A product or offering the business sells. stock = null means "not
// tracked" (services, digital goods, made-to-order).
model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  stock       Int?
  sku         String?
  // Link to the live listing (Etsy page, Shopify product, booking page…)
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  payments Payment[]
}

// A payment received — the finances page is intentionally light for now.
model Payment {
  id         String   @id @default(cuid())
  amount     Float
  note       String?
  quantity   Int      @default(1)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// A niche from content/niches.json — 47 of them. GLOBAL curator content,
// loaded by `npm run catalog:import`. `domain` is the section header the
// Discover feed groups by; `audience` drives the maker/reseller chip and
// the feed's filter.
model Niche {
  id   String @id @default(cuid())
  // Curator-chosen stable identity so re-importing updates in place.
  slug String @unique

  name     String
  // "Home & Living", "Pets"… ten of them, and the Discover section header.
  domain   String
  // One of: maker, reseller, both
  audience String
  // Comma-separated match keywords (same convention as Business fields).
  tags     String

  imageQuery  String?
  imageUrl    String?
  imageCredit String?

  // One of: ACTIVE, ARCHIVED. Archived rather than deleted because
  // TrendProduct.nicheId is SetNull — a delete would silently orphan
  // every product in the niche.
  status String @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products TrendProduct[]

  @@index([domain])
}

// The Discover catalog: a product worth selling, and where to source it.
// GLOBAL content, not user-owned. Rows are loaded by the curator via
// `npm run catalog:import` (see content/README.md); users can only read and
// react. Never accept writes from the API.
//
// This was TrendCard, renamed in place so existing rows and every SavedTrend
// survived. Columns fall into three groups with three different owners, and
// keeping them apart is what lets the feed stay honest:
//
//   editorial  — the curator, via content/products/*.json. Import overwrites.
//   machine    — the ingest pipeline. The importer NEVER touches these.
//   provenance — where each claim came from, so a card can show its working.
model TrendProduct {
  id   String @id @default(cuid())
  // Curator-chosen stable identity so re-importing updates in place.
  slug String @unique

  // --- editorial ----------------------------------------------------------
  title    String
  // Why this could take off, in the curator's words — the card's body text.
  blurb    String
  // Shelf label. For catalog rows the importer writes niche.domain here, so
  // one domain can't wallpaper the feed — this is the ranker's diversity key.
  category String
  // Comma-separated match keywords. Derived from the niche by the importer.
  tags     String

  nicheId String?
  niche   Niche?  @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  // One of: DROPSHIP, WHOLESALE, PRINT_ON_DEMAND, MATERIALS, MAKE_YOUR_OWN
  sourcingType  String?
  // Where the trend was spotted / where to buy, e.g. "AliExpress (glazes)".
  sourceName    String?
  sourceUrl     String?
  // Where to actually buy it — the "Source it" link.
  sourcingUrl   String?
  // Free text as authored, e.g. "$2–8/mug in materials" and "$28–45". Kept
  // as strings because the honest answer is often a range with a unit.
  sourceCost    String?
  typicalResale String?
  // Legacy TrendCard field, superseded by sourceCost/typicalResale.
  priceRange    String?

  imageQuery  String?
  imageUrl    String?
  imageCredit String?

  // Curator-set 0–100: how hot this is right now. INGEST MUST NEVER WRITE
  // THIS. It is the editorial judgement the machine gets measured against.
  hotness Int @default(50)

  // --- machine ------------------------------------------------------------
  // 0–100 from real signals. Null until a source reports on this product,
  // which on day one is all of them.
  heat     Int?
  // The previous poll's heat. heat - heatPrev IS the trending axis; without
  // a stored previous reading "trending" could only ever mean "hot".
  heatPrev Int?

  // Only ever set when the searched term IS the sellable product — see the
  // scope gate in scripts/ingest/score.ts.
  unitsSold Int?
  // Competing sellers. Saturation, not popularity.
  listings  Int?
  priceLow  Float?
  priceHigh Float?

  // Ad pressure. adDaysLive is the winning-product heuristic: a creative
  // still running after weeks is one somebody pays for daily and hasn't
  // switched off.
  adCount    Int?
  adDaysLive Int?
  // Stored and shown, deliberately not scored.
  adReach    Int?

  // Mean daily readers of the subject. Attention, not purchases — and the
  // only measured signal that needs no credential of any kind to obtain.
  interest      Int?
  // Recent month over the one before, as a ratio: 1.35 is a third more
  // attention. Already a derivative, which is what lets the trending sort
  // work on a fresh database where nothing has two heat readings yet.
  interestTrend Float?

  // A live listing found in a merchant catalog. Kept apart from the curator's
  // `sourcingUrl` for the same reason `heat` is kept apart from `hotness`:
  // ingest must never overwrite authored work. The card prefers this when it
  // exists and falls back to the authored link.
  liveSourcingUrl String?
  liveMerchant    String?

  // --- provenance ---------------------------------------------------------
  // "aliexpress,etsy,meta" — which adapters actually reported.
  signalSources   String?
  signalsPolledAt DateTime?
  // "meta" | "manual". An ad run logged at the research bench fills the same
  // columns Meta would, which is what makes the Meta API optional.
  adSource        String?
  // The ad snapshot and advertiser, as links the user opens and judges.
  adEvidenceUrl   String?
  adAdvertiser    String?
  // "EU" when the ad evidence is EU-reach only, which all non-political Meta
  // data is. The card says so rather than implying global coverage.
  adCoverage      String?

  // One of: ACTIVE, ARCHIVED. Archived cards leave the feed but existing
  // saves keep working, so nobody's idea shelf silently loses entries.
  status String @default("ACTIVE")
  // CATALOG (content/*.json) | INGEST (--discover) | LEGACY (pre-rename
  // TrendCards, which have no niche and stay out of the catalog feed).
  origin String @default("CATALOG")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reactions SavedTrend[]

  @@index([status])
  @@index([nicheId])
  @@index([status, heat])
  @@index([status, interestTrend])
}

// Curated content for the Growth feed: a community/place where a business
// finds customers, written up as a coached blog-style post. Same global,
// curator-owned model as TrendCard: loaded via `npm run growth:import`,
// read-only through the API. Live stats (memberCount, icon images) are
// nullable — a later enricher job fills them from sanctioned APIs (Reddit
// public JSON, YouTube API); nothing is ever scraped against ToS.
model CommunityPost {
  id   String @id @default(cuid())
  // Curator-chosen stable identity so re-importing updates in place.
  slug String @unique

  title    String
  // Where it lives: Reddit, Instagram, TikTok, X, YouTube, Etsy, Pinterest,
  // Facebook, Forum… Drives feed diversity and card styling.
  platform String
  // One of: community, hashtag, marketplace, search, event
  kind     String
  url      String

  // Card text (one line) and the blog-post depth behind the tap.
  // The post reads as a PROFILE of the community — descriptive, editorial —
  // with the how-to-approach guidance as a side element at the end.
  tagline     String
  // Who a business will actually find there — buyers, peers, lurkers.
  audience    String
  // What this place is. Paragraphs separated by blank lines.
  overview    String
  // What people talk about and discuss. One item per line.
  discussions String
  // Buyer behavior: what wins them over / what turns them off. One per line.
  loves       String
  dislikes    String
  // Community rules and platform norms that limit how you can show up.
  rules       String
  // The side element at the end: how to actually approach this place.
  approach    String

  // Comma-separated match keywords (same convention as Business fields).
  tags String

  imageUrl    String?
  // Filled by the enricher where an official API provides it.
  memberCount Int?
  // Curator-set 0–100 editorial priority.
  hotness     Int     @default(50)
  // One of: ACTIVE, ARCHIVED
  status      String  @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A user's reaction to a trend card. state: SAVED (their idea shelf) or
// DISMISSED (never show again). Doubles as the engagement log the ranking
// algorithm will learn from later.
model SavedTrend {
  id        String   @id @default(cuid())
  // One of: SAVED, DISMISSED
  state     String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Column keeps its name through the TrendCard -> TrendProduct rename: it
  // appears in emitted `trend.saved` payloads and the analytics stream, and
  // renaming it would break those for nothing.
  trendCardId String
  trendCard   TrendProduct @relation(fields: [trendCardId], references: [id], onDelete: Cascade)

  @@unique([userId, trendCardId])
  @@index([userId, state])
}

model Interaction {
  id     String  @id @default(cuid())
  // One of: MESSAGE, MEETING, PURCHASE, REVIEW, OTHER
  type   String
  note   String?
  // Subjective impact/value of this interaction, 1 (light touch) - 5 (major, e.g. a sale).
  weight Int     @default(1)

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}
