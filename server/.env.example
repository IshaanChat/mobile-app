# Copy to .env and fill in. The real .env is git-ignored — never commit it.

# --- Database (Neon Postgres) -------------------------------------------
# From the Neon dashboard for your sales-mechanic project, click
# "Connect" and copy the connection string.
#
# IMPORTANT: use the DIRECT connection, not the pooled one. In the Neon
# dialog, turn OFF "Connection pooling" (the pooled host has "-pooler" in
# it). Prisma Migrate cannot run through the pooler.
#
# It should look like:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=4000

# --- CORS ---------------------------------------------------------------
# Production only: the deployed client's origin, e.g.
#   CLIENT_ORIGIN=https://sales-mechanic.vercel.app
# Leave unset locally — any origin is allowed when this is empty.
# CLIENT_ORIGIN=

# --- Auth (Clerk) -------------------------------------------------------
# When set, the API verifies Clerk session tokens. When unset (local dev),
# the caller is the development account and no sign-in is required.
# Get it from the Clerk dashboard -> API Keys. Keep it SECRET.
# CLERK_SECRET_KEY=sk_test_xxxxxxxx

# --- Optional: self-hosted LLM for the Discover tab ---------------------
# Any OpenAI-compatible server (Ollama, LM Studio, vLLM, llama.cpp).
# Leave unset to use the built-in recommendation engine.
# These can also be set from the UI (My Business -> Settings -> Your AI),
# which stores them in the database and takes precedence over this file.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=

# --- Ingest: demand signals for Discover (npm run ingest) ---------------
# Every source is optional and skips cleanly without a key, so ingest is
# useful from the first approval rather than needing all of them. Nothing
# here scrapes — these are all official, documented APIs.

# AliExpress Affiliate — the one that matters. The only source that returns
# actual products, real unit costs and a sourcing link, and it pays
# commission. Apply at portals.aliexpress.com, then create an app of type
# "Affiliate API" on the Open Platform. Usually ~2 business days; may ask
# for ID or a business licence.
# ALIEXPRESS_APP_KEY=
# ALIEXPRESS_APP_SECRET=
# ALIEXPRESS_TRACKING_ID=venturo

# Etsy Open API v3 — listing counts and price bands for the handmade half
# of the catalog, which is most of it. A keystring alone is enough for
# public listing search; no OAuth. developers.etsy.com. Review can take a
# few days now, so apply before you need it.
# ETSY_API_KEY=

# Meta Ad Library — ad pressure, the "is anyone paying to push this right
# now" signal. Official Graph API (ads_archive), no scraping.
#
# Two things to know before applying. Coverage: outside the EU only
# political and social-issue ads are returned, so commercial data means
# EU-reaching ads. Signals are stamped adCoverage=EU and the app says so
# rather than implying global. Access: needs identity verification at
# facebook.com/ID plus app review, and Meta's stated categories are
# political research, academic research and journalism — product research
# is none of those, so approval is not guaranteed. Everything degrades
# gracefully without it; the research bench fills the same fields by hand.
# META_ACCESS_TOKEN=
# Comma-separated ISO country codes to search. EU members only, or the
# commercial ads disappear from the results.
# META_COUNTRIES=DE,FR,NL,IE,ES,IT
# Hard cap on Meta calls per run. The API allows ~200/hour and pagination
# counts against it, so a full refresh is spread over several nights.
# META_CALLS_PER_RUN=150

# CJ Affiliate — the best credential-to-value ratio available. One free
# publisher account at cj.com/publisher, then a Personal Access Token from
# developers.cj.com, and you get product feeds across 15,000+ advertisers.
# Crucially, product search returns advertisers you have NOT joined: merchant
# approval gates commission, not reading, so this is useful the day the
# account exists and the money comes later.
#
# It reports prices, live listings and how many merchants carry a category.
# It never reports units sold — a catalog knows what is listed, not what
# anyone bought.
# CJ_ACCESS_TOKEN=
# CJ_COMPANY_ID=
# Calls per run. CJ's published limits could not be confirmed from public
# docs, so this errs high; lower it if you see throttling.
# CJ_CALLS_PER_RUN=400

# --- Wikimedia pageviews: no credential needed --------------------------
# Nothing to set. The pageview API takes no key, no signup and no auth, so
# ingest produces measured evidence for every product with an empty .env.
# Two things worth knowing if you touch that adapter: it rate-limits after
# roughly twenty rapid requests (results are cached per subject, so a full
# run makes 47 calls rather than 188), and it returns 404 for a real article
# about half the time, which is why requests are retried with the window
# nudged. Each niche in content/niches.json carries a `wikiTitle`, because
# no niche name is an article and a near-miss title returns plausible
# single-digit numbers instead of an error.

# --- Images (npm run growth:images) -------------------------------------
# Pexels, for free-licence imagery only. Never grab images from the web.
# pexels.com/api
# PEXELS_API_KEY=
