# Copy to .env and adjust. The real .env is git-ignored.

DATABASE_URL="file:./dev.db"
PORT=4000

# Optional: self-hosted LLM for the Discover tab (OpenAI-compatible API).
# Works with Ollama, vLLM, LM Studio, llama.cpp server, etc.
# Leave unset to use the built-in recommendation engine.
# These can also be set from the UI (My Business → Settings → Your AI),
# which stores them in the database and takes precedence over this file.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
