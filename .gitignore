# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Local database (contains real business data — never commit).
# Broad on purpose: *.db* also catches dev.db-journal, dev.db.backup,
# dev.db.demo-aside and anything else derived from a database file.
*.db*
*.sqlite*
prisma/*.db*

# Logs
*.log
npm-debug.log*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Xcode — generated per-developer state, not project configuration
ios/**/xcuserdata/
ios/**/*.xcworkspace/xcuserdata/
ios/build/
ios/DerivedData/
.DS_Store

# CloudKit server-to-server private key — never commit
server/cloudkit-key.pem
cloudkit-key.pem
