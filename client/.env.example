# Copy to .env.local for local overrides. Not needed for normal local dev —
# Vite proxies /api to localhost:4000 automatically.
#
# Set this in the Vercel dashboard (Project -> Settings -> Environment
# Variables) to the Render API URL, with no trailing slash and no /api:
#
#   VITE_API_URL=https://sales-mechanic-api.onrender.com
#
# VITE_API_URL=
