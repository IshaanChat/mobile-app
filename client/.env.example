# Copy to .env.local for local overrides. Neither is needed for normal local
# dev — Vite proxies /api to localhost:4000, and with no Clerk key the app
# signs you in automatically as the development account.

# Production API origin (set in Vercel), no trailing slash and no /api:
#   VITE_API_URL=https://sales-mechanic-api.onrender.com
# VITE_API_URL=

# Clerk publishable key (safe to expose — it is a public key). When set, the
# app requires real sign-in. Get it from the Clerk dashboard -> API Keys.
#   VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# VITE_CLERK_PUBLISHABLE_KEY=
